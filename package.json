{
  "name": "hokka",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:heavy": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size-check.js",
    "ocr:assets": "node scripts/sync-ocr-assets.js",
    "postinstall": "node scripts/sync-ocr-assets.js",
    "check": "npm run typecheck && npm run lint && npm run size",
    "format": "prettier --write .",
    "types:extract": "node scripts/extract-types.js --apply",
    "components:group": "node scripts/group-components.js",
    "components:group:apply": "node scripts/group-components.js --apply",
    "organize": "npm run types:extract && npm run components:group",
    "oneliners": "node scripts/find-oneline-functions.js",
    "aliases": "node scripts/find-oneline-functions.js --alias",
    "arrows": "node scripts/arrow-to-function.js"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/is-prop-valid": "^1.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.2.12",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.4.2",
    "typescript": "^5"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "arrowParens": "always",
    "tabWidth": 2,
    "useTabs": false,
    "quoteProps": "consistent",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "proseWrap": "preserve"
  }
}
